{
  "hosting": {
    "public": "web/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "diff -q \"$PROJECT_DIR/docs/privacy-policy.html\" \"$RESOURCE_DIR/privacy-policy.html\" || { echo 'docs/privacy-policy.html と web/public/privacy-policy.html が違います。新しいほうをもう片方へ cp してください（.agents/privacy-policy.md の「公開のしかた」）' >&2; exit 1; }"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        "test",
        "lib/test",
        "*.log",
        ".secret.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  }
}
